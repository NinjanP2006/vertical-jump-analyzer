# Public client-side config for the deployed backend. Committed on purpose: Vite inlines these
# into the browser bundle, so they are NOT secrets — every visitor's browser already has them.
# Vercel (and any host) reads this file at build time, so no dashboard env-var setup is needed.
# `.env.local` still overrides these locally if present.
VITE_AWS_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=us-east-1_bGSkLK06i
VITE_COGNITO_CLIENT_ID=2cgc78fu5eoh3j34pqmoh6vkha
VITE_COGNITO_DOMAIN=https://vja-bbee980b.auth.us-east-1.amazoncognito.com
VITE_API_URL=https://pf9mx11iuj.execute-api.us-east-1.amazonaws.com
