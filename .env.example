# Copy to .env.local and fill from your `cdk deploy` outputs (see infra/README.md).
# Optional — the app runs fully without these; accounts/history just stay disabled.
VITE_AWS_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_COGNITO_DOMAIN=https://your-prefix.auth.us-east-1.amazoncognito.com
VITE_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com
